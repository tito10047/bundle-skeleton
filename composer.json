{
    "name": "yceruto/bundle-skeleton",
    "description": "Skeleton to create Symfony bundles that follow the best practices, with an interactive assistant",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "bundle",
        "skeleton"
    ],
    "require": {
        "php": ">=8.2",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "require-dev": {
        "yceruto/bundle-flex": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "yceruto/bundle-flex": true
        },
        "sort-packages": true
    }
}
